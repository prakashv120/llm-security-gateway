# Application Configuration
APP_NAME="LLM Security Gateway"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT="production"

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# PostgreSQL Database Configuration
DATABASE_URL="postgresql+asyncpg://postgres:Prakash@123D@localhost:5432/llm_security_gateway"
DATABASE_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Ollama LLM Configuration
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
OLLAMA_TIMEOUT_SECONDS=30.0

# Security Risk Thresholds (0.0 to 1.0)
# Risk Score < 0.3  -> ALLOW (or MASK if PII detected)
# 0.3 <= Score < 0.7 -> REVIEW
# Score >= 0.7       -> BLOCK
THRESHOLD_ALLOW=0.3
THRESHOLD_REVIEW=0.7

# PII Redaction Configuration
MASK_PII_BEFORE_FORWARDING=true

# Output Guardrail Configuration
ENABLE_OUTPUT_GUARDRAILS=true
